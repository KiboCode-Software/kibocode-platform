# El frontend NO necesita configuración para funcionar.
#
# Las peticiones a la API van al mismo origen (`/api/...`): en desarrollo las
# enruta el proxy de Vite (ver vite.config.js) y en producción lo hace nginx.
#
# Solo define esto si algún día la API vive en otro dominio:
# VITE_API_URL=https://api.kibocode.lat
#
# Y esto si el backend local corre en un puerto distinto al 8000:
# VITE_PROXY_TARGET=http://localhost:9000
