# Servicio systemd para el backend de KiboCode.
#
#   sudo cp deploy/kibocode.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kibocode
#   sudo systemctl status kibocode
#   journalctl -u kibocode -f
#
# Ajusta User/WorkingDirectory si desplegaste en otra ruta.

[Unit]
Description=KiboCode — plataforma interna (Django + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/kibocode/backend

# Las variables sensibles viven en este archivo, no en la unidad.
# Debe ser propiedad de root con permisos 600.
EnvironmentFile=/srv/kibocode/backend/.env

ExecStart=/srv/kibocode/backend/.venv/bin/gunicorn \
    -c /srv/kibocode/deploy/gunicorn.conf.py \
    kibocode.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Endurecimiento básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/srv/kibocode/backend

[Install]
WantedBy=multi-user.target
