# Copia este archivo a `.env` y completa los valores.
# `.env` nunca se sube al repositorio.

# --- Django ---------------------------------------------------------------
# En producción: genera una nueva con
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
# En producción: kibocode.lat,www.kibocode.lat
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos --------------------------------------------------------
# Postgres de Supabase. Usa el connection string en modo "Session pooler"
# si el backend corre con varios workers de gunicorn.
# Si se deja vacío, en desarrollo cae a SQLite local.
DATABASE_URL=

# Con el Transaction pooler de Supabase hay que poner 0.
CONN_MAX_AGE=600

# --- Dominio y seguridad --------------------------------------------------
# Obligatorio en Django 4+ para el admin por HTTPS.
# En producción: https://kibocode.lat,https://www.kibocode.lat
CSRF_TRUSTED_ORIGINS=

# Actívalo (31536000) solo cuando el HTTPS ya funcione.
SECURE_HSTS_SECONDS=0
# nginx ya redirige a HTTPS; deja esto en False salvo que sirvas sin proxy.
SECURE_SSL_REDIRECT=False

LOG_LEVEL=INFO

# --- CORS -----------------------------------------------------------------
# En producción no hace falta: frontend y API comparten dominio.
# Solo se usa en desarrollo si el frontend no pasa por el proxy de Vite.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Motor de PDF ---------------------------------------------------------
# auto (por defecto) usa WeasyPrint si está disponible y, si no, Playwright.
# Valores: auto | weasyprint | playwright
PDF_ENGINE=auto

# --- Datos fijos de KiboCode para los documentos --------------------------
KIBO_RAZON_SOCIAL=Juan Manuel Colorado Duque
KIBO_NOMBRE_COMERCIAL=KiboCode
# Cédula o NIT del prestador. Obligatorio para contratos y NDA.
KIBO_DOCUMENTO=
KIBO_WHATSAPP=+57 312 688 6357
KIBO_WHATSAPP_PLAIN=573126886357
KIBO_EMAIL=contacto@kibocode.lat
KIBO_CIUDAD=
